{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/evidence.v1.schema.json",
  "title": "evidence.claim.v1",
  "description": "One physical evidence directory per claim. NO claim is reported without this file. Empty commands or empty assertions is structurally invalid — JSON Schema validation will fail.",
  "type": "object",
  "required": [
    "version",
    "claim",
    "slug",
    "agent",
    "session_id",
    "produced_at",
    "target_environment",
    "verification_method",
    "preconditions",
    "commands",
    "assertions",
    "files_changed",
    "artifacts",
    "remaining_gaps",
    "self_recheck"
  ],
  "additionalProperties": false,
  "properties": {
    "version": { "const": 1 },
    "claim": {
      "type": "string",
      "minLength": 1,
      "description": "The exact sentence you intend to send to the user. Mirror it verbatim in the report."
    },
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{0,63}$",
      "description": "Kebab-case label matching the directory name."
    },
    "task_id": {
      "type": ["string", "null"],
      "description": "Parent task/issue/MR/PR id, or null."
    },
    "agent": { "type": "string", "minLength": 1 },
    "session_id": { "type": "string", "minLength": 1 },
    "produced_at": { "type": "string", "format": "date-time" },
    "target_environment": {
      "enum": [
        "backend",
        "cli",
        "frontend",
        "browser",
        "integration",
        "static-analysis",
        "test-suite",
        "db-migration",
        "docs",
        "other"
      ]
    },
    "verification_method": {
      "enum": [
        "command",
        "test-suite",
        "browser-automation",
        "static-analysis",
        "manual",
        "e2e-scenario"
      ]
    },
    "preconditions": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 },
      "description": "What was true before this claim became testable. Non-empty."
    },
    "commands": {
      "type": "array",
      "minItems": 1,
      "description": "REAL executed commands. Empty array fails validation.",
      "items": {
        "type": "object",
        "required": ["cmd", "cwd", "exit_code", "duration_ms", "stdout_excerpt"],
        "additionalProperties": false,
        "properties": {
          "cmd": { "type": "string", "minLength": 1, "description": "Exact command, no abbrev." },
          "cwd": { "type": "string", "minLength": 1, "description": "Absolute path." },
          "exit_code": { "type": "integer", "description": "Real exit code of the command THIS turn." },
          "duration_ms": { "type": "integer", "minimum": 0, "description": "Wall-clock time in ms." },
          "stdout_excerpt": { "type": "string", "minLength": 1, "description": "Trimmed but lossless around the assertion line." },
          "stderr_excerpt": { "type": ["string", "null"] }
        }
      }
    },
    "assertions": {
      "type": "array",
      "minItems": 1,
      "description": "Each assertion name MUST map to a literal line in commands[].stdout_excerpt or in a sibling artifact. Names without a matching quote fail validation downstream.",
      "items": {
        "type": "object",
        "required": ["name", "passed", "evidence_quote"],
        "additionalProperties": false,
        "properties": {
          "name": { "type": "string", "minLength": 1, "description": "Short, killable assertion name." },
          "passed": { "type": "boolean" },
          "evidence_quote": {
            "type": "string",
            "minLength": 1,
            "description": "Exact line from output that made you mark it passed/failed."
          }
        }
      }
    },
    "files_changed": {
      "type": "array",
      "items": { "type": "string" }
    },
    "diffs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path"],
        "additionalProperties": false,
        "properties": {
          "path": { "type": "string" },
          "unified_diff": { "type": ["string", "null"] }
        }
      }
    },
    "artifacts": {
      "type": "array",
      "description": "For browser: MUST include ≥ 1 screenshot or trace. For db-migration: MUST include ≥ 1 log with post-migration schema."
    },
    "remaining_gaps": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Honest, non-decorative list of what is NOT yet proven."
    },
    "self_recheck": {
      "type": "object",
      "required": ["performed", "performed_at", "method", "result"],
      "additionalProperties": false,
      "properties": {
        "performed": { "const": true },
        "performed_at": { "type": "string", "format": "date-time" },
        "method": {
          "type": "string",
          "enum": ["re-read-file", "re-ran-command", "sampled-output"]
        },
        "result": {
          "enum": ["still-holds", "drifted", "invalid"]
        }
      }
    }
  },
  "allOf": [
    {
      "description": "Browser claims MUST include a screenshot or trace artifact (curl alone is NOT evidence for browser behaviour).",
      "if": {
        "properties": { "target_environment": { "const": "browser" } },
        "required": ["target_environment"]
      },
      "then": {
        "properties": {
          "artifacts": {
            "minItems": 1,
            "contains": {
              "type": "object",
              "required": ["kind"],
              "properties": {
                "kind": { "enum": ["screenshot", "trace", "e2e-evidence"] }
              }
            }
          }
        }
      }
    },
    {
      "description": "DB-migration claims MUST include a log artifact with the post-migration schema.",
      "if": {
        "properties": { "target_environment": { "const": "db-migration" } },
        "required": ["target_environment"]
      },
      "then": {
        "properties": {
          "artifacts": {
            "minItems": 1,
            "contains": {
              "type": "object",
              "required": ["kind"],
              "properties": { "kind": { "const": "log" } }
            }
          }
        }
      }
    },
    {
      "description": "Static-analysis claims MUST have ≥ 1 assertion whose evidence_quote is a literal line containing '0 errors' or '0 warnings' from one of the tools.",
      "if": {
        "properties": { "target_environment": { "const": "static-analysis" } },
        "required": ["target_environment"]
      },
      "then": {
        "properties": {
          "assertions": {
            "contains": {
              "type": "object",
              "required": ["evidence_quote"],
              "properties": {
                "evidence_quote": {
                  "type": "string",
                  "pattern": "(0 errors|0 warnings|no errors|no warnings)"
                }
              }
            }
          }
        }
      }
    }
  ]
}
