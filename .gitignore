node_modules/
.DS_Store
*.log
.env
.env.*
tmp/
.doctor/
skillspector.sarif
# Nx cache (populated by actions/skillspector; do not commit)
.nx/
# Python bytecode
**/__pycache__/
*.pyc
# Transient memory files
.memory/

.bob
# Generated from skills/tools/skillmaker/assets/agents/*.yaml
scripts/reserved-names.sh

# Generated by scripts/generate-skills-index.ts; built as CI artifacts
.claude-plugin/skills-index.json
.claude-plugin/skills-index.schema.json

# Generated by scripts/generate-skills-graph.ts; the .md files in docs/graphs/
# are committed for github.com mermaid rendering, but the adjacency JSON and
# any out-of-tree build outputs are not.
.build/

# Local Obsidian vault preview (created by npm run obsidian:build)
skills-obsidian/

# Drill artifacts (transient, do not commit)
.drills/
.obsidian/

# Generated flat skill view and Mermaid graphs; source of truth is skills/.
.agents/skills/
docs/graphs/generated/

# Generated human-readable skills index; published to theplenkov-ai/skills-sync
docs/skills-index.md

# Built compiler output; rebuilt on demand (npx tsc -p tools/compiler/tsconfig.json)
tools/compiler/dist/
tools/nx-skill/dist/
