{
  "name": "@theplenkov/skills",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "bin": {
    "skills": "./bin/skills.js"
  },
  "scripts": {
    "generate": "tsx scripts/generate-skills-index.ts",
    "graph": "tsx scripts/generate-skills-graph.ts --json .build/skills-graph.json --graph-dir docs/graphs/generated",
    "graph:update": "tsx scripts/generate-skills-graph.ts --json .build/skills-graph.json --graph-dir docs/graphs/generated",
    "validate": "tsx scripts/run.ts scripts/validate-skills-index.sh",
    "validate:update": "tsx scripts/run.ts scripts/validate-skills-index.sh --update",
    "install:skills": "tsx scripts/run.ts scripts/install.sh",
    "typecheck": "tsc --noEmit",
    "check:os": "tsx scripts/check-os-independence.ts",
    "check:readme-categories": "tsx scripts/run.ts scripts/check-readme-categories.ts",
    "test": "bun test scripts/"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "ajv-cli": "5.0.0",
    "markdownlint-cli2": "0.23.1",
    "tsx": "^4.0.0",
    "typescript": "^5.0.0",
    "yaml": "^2.0.0",
    "zod": "^3.0.0",
    "zod-to-json-schema": "^3.0.0"
  },
  "overrides": {
    "ajv-cli": {
      "fast-json-patch": "3.1.1",
      "glob": "13.0.6",
      "minimatch": "10.2.5",
      "brace-expansion": "5.0.8"
    },
    "markdownlint-cli2": {
      "js-yaml": "5.2.2"
    }
  }
}
