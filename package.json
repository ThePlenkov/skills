{
  "name": "@theplenkov/skills",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "bin": {
    "skills": "./bin/skills.js"
  },
  "scripts": {
    "postinstall": "cd tools/compiler && npm run build && cd ../.. && npm run build:nx-plugins",
    "build:nx-plugins": "tsx scripts/build-nx-plugins.ts",
    "generate": "tsx scripts/generate-skills-index.ts",
    "generate:skills-index-md": "tsx scripts/generate-skills-index-md.ts",
    "check:skills-index-md": "tsx scripts/generate-skills-index-md.ts --check",
    "generate:public-readme": "tsx scripts/generate-public-readme.ts --out .build/public-readme.md",
    "check:public-readme": "tsx scripts/generate-public-readme.ts --out .build/public-readme.md --check",
    "graph": "tsx scripts/generate-skills-graph.ts --json .build/skills-graph.json --graph-dir docs/graphs/generated",
    "graph:update": "tsx scripts/generate-skills-graph.ts --json .build/skills-graph.json --graph-dir docs/graphs/generated",
    "obsidian:build": "tsx scripts/obsidian-vault.ts --source .agents/skills --out skills-obsidian --clean",
    "validate": "tsx scripts/run.ts scripts/validate-skills-index.sh",
    "validate:update": "tsx scripts/run.ts scripts/validate-skills-index.sh --update",
    "install:skills": "tsx scripts/run.ts scripts/install.sh",
    "typecheck": "tsc --noEmit",
    "check:os": "tsx scripts/check-os-independence.ts",
    "check:readme-categories": "tsx scripts/run.ts scripts/check-readme-categories.ts",
    "test": "bun test scripts/"
  },
  "devDependencies": {
    "@nx/devkit": "^23.1.0",
    "@nx-devkit/skill": "file:./vendor/nx.ts/packages/skill",
    "@nx-devkit/skillspector": "file:./vendor/nx.ts/packages/skillspector",
    "@theplenkov/skills-compiler": "file:./tools/compiler",
    "@types/node": "^20.0.0",
    "ajv-cli": "5.0.0",
    "markdownlint-cli2": "0.23.1",
    "nx": "^23.1.0",
    "tsx": "^4.0.0",
    "typescript": "^5.0.0",
    "yaml": "^2.0.0",
    "zod": "^3.0.0",
    "zod-to-json-schema": "^3.0.0"
  },
  "overrides": {
    "ajv-cli": {
      "fast-json-patch": "3.1.1",
      "glob": "13.0.6",
      "minimatch": "10.2.5",
      "brace-expansion": "5.0.9",
      "js-yaml": "3.15.1"
    },
    "markdownlint-cli2": {
      "js-yaml": "5.2.2"
    },
    "fast-uri": "3.1.5",
    "axios": "1.18.1",
    "brace-expansion": "5.0.9"
  }
}
